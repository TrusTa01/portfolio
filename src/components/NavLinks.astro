---
import { AVAILABLE_PAGES, navItems } from '../navigation/nav.ts';
import { t } from '../i18n/t.ts';
import type { Locale } from '../i18n/locales.ts';

type Props = { locale: Locale; class?: string };
const { locale, class: className } = Astro.props;
---
<nav aria-label={t(locale, 'nav.label')} class:list={['gap-1', className]}>
<ul class="contents">
  {navItems(locale, AVAILABLE_PAGES).map((item) => (
    <li>
      <a href={item.href} class="block rounded px-3 py-2 hover:text-[var(--accent)]">{t(locale, item.key)}</a>
    </li>
  ))}
</ul>
</nav>
