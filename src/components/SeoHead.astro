---
import { LOCALE_TAGS, type Locale } from '../i18n/locales.ts';
import { alternateLinks } from '../i18n/seo.ts';

type Props = { locale: Locale; title: string; description: string };

const OG_LOCALE_FROM = '-';
const OG_LOCALE_TO = '_';

const { locale, title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alternates = alternateLinks(Astro.url.pathname, Astro.site!);
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={LOCALE_TAGS[locale].replace(OG_LOCALE_FROM, OG_LOCALE_TO)} />
