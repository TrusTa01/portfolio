---
import { t } from '../../i18n/t.ts';
import type { Locale } from '../../i18n/locales.ts';
import type { HomeContent } from '../../content/home-schema.ts';

type Props = { locale: Locale; services: HomeContent['services'] };
const { locale, services } = Astro.props;
---
<section class="py-12">
  <h2 class="text-2xl font-semibold">{t(locale, 'home.services')}</h2>
  <ul class="mt-6 grid gap-4 md:grid-cols-3">
    {services.map((service) => (
      <li class="rounded-lg border border-[var(--muted)]/30 p-4">
        <h3 class="font-semibold">{service.title}</h3>
        <p class="mt-3 text-sm text-[var(--muted)]">{t(locale, 'home.services.tools')}</p>
        <p class="text-sm">{service.tools.join(', ')}</p>
        <p class="mt-3 text-sm text-[var(--muted)]">{t(locale, 'home.services.result')}</p>
        <p class="text-sm">{service.result}</p>
      </li>
    ))}
  </ul>
</section>
