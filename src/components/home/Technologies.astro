---
import { AVAILABLE_PAGES, pageHref } from '../../navigation/nav.ts';
import { t } from '../../i18n/t.ts';
import type { Locale } from '../../i18n/locales.ts';
import type { HomeContent } from '../../content/home-schema.ts';

type Props = { locale: Locale; technologies: HomeContent['technologies'] };
const { locale, technologies } = Astro.props;
---
<section class="py-12">
  <h2 class="text-2xl font-semibold">{t(locale, 'home.technologies')}</h2>
  <p class="mt-4 max-w-2xl">{technologies.intro}</p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {technologies.items.map((item) => (
      <li class="rounded-full border border-[var(--muted)]/40 px-3 py-1 text-sm">{item}</li>
    ))}
  </ul>
  {AVAILABLE_PAGES.resume && (
    <a href={pageHref(locale, 'resume')} class="mt-4 inline-block text-[var(--accent)] hover:underline">
      {t(locale, 'home.resumeLink')}
    </a>
  )}
</section>
