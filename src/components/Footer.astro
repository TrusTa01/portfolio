---
import { siteConfig } from '../site.config.ts';
import { contactLinks, type ContactKind } from '../site/contacts.ts';
import { identityLabel } from '../site/identity.ts';
import { AVAILABLE_PAGES, pageHref, sectionHref } from '../navigation/nav.ts';
import { t, type UiKey } from '../i18n/t.ts';
import type { Locale } from '../i18n/locales.ts';

type Props = { locale: Locale };
type FooterLink = { key: UiKey; href: string };

const { locale } = Astro.props;
const identity = identityLabel(siteConfig);
const contacts = contactLinks(siteConfig);
const hrefOf = (kind: ContactKind) => contacts.find((link) => link.kind === kind)?.href;

const entries: { key: UiKey; href: string | undefined }[] = [
  { key: 'header.github', href: hrefOf('github') },
  { key: 'header.telegram', href: hrefOf('telegram') },
  { key: 'nav.projects', href: AVAILABLE_PAGES.projects ? pageHref(locale, 'projects') : undefined },
  { key: 'nav.resume', href: AVAILABLE_PAGES.resume ? pageHref(locale, 'resume') : undefined },
  { key: 'footer.contact', href: sectionHref(locale, 'contacts') },
];
const links = entries.filter((entry): entry is FooterLink => entry.href !== undefined);
---
<footer class="mt-16 border-t border-[var(--muted)]/30">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-8 md:flex-row md:items-center md:justify-between">
    <div>
      {identity !== '' && <p class="font-semibold">{identity}</p>}
      <p class="text-sm text-[var(--muted)]">{t(locale, 'footer.tagline')}</p>
    </div>
    <ul class="flex flex-wrap gap-x-4 gap-y-1">
      {links.map((link) => <li><a href={link.href} class="hover:text-[var(--accent)]">{t(locale, link.key)}</a></li>)}
    </ul>
  </div>
</footer>
