---
import '../styles/global.css';
import type { Locale } from '../i18n/locales.ts';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeadBase from '../components/HeadBase.astro';
import SeoHead from '../components/SeoHead.astro';

type Props = { locale: Locale; title: string; description: string };
const { locale, title, description } = Astro.props;
---
<html lang={locale}>
  <head>
    <HeadBase />
    <SeoHead locale={locale} title={title} description={description} />
  </head>
  <body class="min-h-screen">
    <Header locale={locale} />
    <main class="mx-auto max-w-5xl px-4 py-8"><slot /></main>
    <Footer locale={locale} />
    <script>
      import '../scripts/theme-toggle.ts';
      import '../scripts/locale-memory.ts';
    </script>
  </body>
</html>
